<script>
const calculators = {

  days: {
    title: "日数計算",
    description: "2つの日付の間の日数を計算します。",
    fields: [
      { id: "start", label: "開始日", type: "date" },
      { id: "end", label: "終了日", type: "date" }
    ],
    calc: v => {
      const a = new Date(v.start + "T00:00:00");
      const b = new Date(v.end + "T00:00:00");
      const days = Math.abs(Math.round((b - a) / 86400000));
      return {
        result: `${days.toLocaleString()} 日`,
        note: "開始日と終了日の差を日数で表示しています。"
      };
    }
  },

  age: {
    title: "年齢計算",
    description: "生年月日から現在の満年齢を計算します。",
    fields: [
      { id: "birth", label: "生年月日", type: "date" }
    ],
    calc: v => {
      const birth = new Date(v.birth + "T00:00:00");
      const today = new Date();
      let age = today.getFullYear() - birth.getFullYear();
      const birthday =
        new Date(today.getFullYear(), birth.getMonth(), birth.getDate());

      if (today < birthday) age--;

      return {
        result: `${age} 歳`,
        note: "現在日時を基準に満年齢を計算しています。"
      };
    }
  },

  utility: {
    title: "水道・光熱費計算",
    description: "電気・ガス・水道の月額と年間費用を計算します。",
    fields: [
      { id: "electric", label: "電気代（月額・円）", type: "number", min: 0 },
      { id: "gas", label: "ガス代（月額・円）", type: "number", min: 0 },
      { id: "water", label: "水道代（月額・円）", type: "number", min: 0 }
    ],
    calc: v => {
      const monthly = v.electric + v.gas + v.water;
      return {
        result: `月額 ${yen(monthly)} ／ 年間 ${yen(monthly * 12)}`,
        note: "入力した3項目の単純合計です。"
      };
    }
  },

  loan: {
    title: "ローン計算",
    description: "元利均等返済方式で毎月返済額を計算します。",
    fields: [
      { id: "principal", label: "借入額（円）", type: "number", min: 0 },
      { id: "rate", label: "年利（%）", type: "number", min: 0, step: 0.01 },
      { id: "years", label: "返済期間（年）", type: "number", min: 1, step: 1 }
    ],
    calc: v => loanResult(v.principal, v.rate, v.years)
  },

  salary: {
    title: "給料・手取り計算",
    description: "額面年収から、設定した控除率を使って簡易的な手取り額を計算します。",
    fields: [
      { id: "gross", label: "額面年収（円）", type: "number", min: 0 },
      { id: "deduction", label: "控除率（%）", type: "number", min: 0, max: 100, step: 0.1, value: 20 }
    ],
    calc: v => {
      const take = v.gross * (1 - v.deduction / 100);
      return {
        result: `手取り目安 ${yen(take)} / 年`,
        note: "実際の所得税・住民税・社会保険料等は個人条件により異なります。"
      };
    }
  },

  saving: {
    title: "貯蓄計算",
    description: "毎月の貯蓄額と期間から貯蓄総額を計算します。",
    fields: [
      { id: "monthly", label: "毎月の貯蓄額（円）", type: "number", min: 0 },
      { id: "years", label: "期間（年）", type: "number", min: 0, step: 1 }
    ],
    calc: v => {
      const total = v.monthly * v.years * 12;
      return {
        result: `${yen(total)}`,
        note: "利息や運用益を考慮しない単純な貯蓄額です。"
      };
    }
  },

  compound: {
    title: "複利計算",
    description: "元本を複利で運用した場合の将来金額を計算します。",
    fields: [
      { id: "principal", label: "元本（円）", type: "number", min: 0 },
      { id: "rate", label: "年利（%）", type: "number", step: 0.01 },
      { id: "years", label: "運用期間（年）", type: "number", min: 0, step: 1 }
    ],
    calc: v => {
      const total = v.principal * Math.pow(1 + v.rate / 100, v.years);
      return {
        result: `将来金額 ${yen(total)}`,
        note: "年1回複利として計算しています。税金・手数料は考慮していません。"
      };
    }
  },

  investment: {
    title: "積立計算",
    description: "毎月一定額を積み立て、月次複利で運用した場合の将来金額を計算します。",
    fields: [
      { id: "monthly", label: "毎月の積立額（円）", type: "number", min: 0 },
      { id: "rate", label: "年利（%）", type: "number", step: 0.01 },
      { id: "years", label: "積立期間（年）", type: "number", min: 0, step: 1 }
    ],
    calc: v => {
      const months = Math.round(v.years * 12);
      const r = v.rate / 100 / 12;

      let total;
      if (r === 0) {
        total = v.monthly * months;
      } else {
        total = v.monthly * ((Math.pow(1 + r, months) - 1) / r);
      }

      return {
        result: `将来金額 ${yen(total)}`,
        note: "毎月末に積み立てる前提の簡易計算です。"
      };
    }
  },

  yield: {
    title: "投資利回り計算",
    description: "投資額と年間収益から簡易的な利回りを計算します。",
    fields: [
      { id: "amount", label: "投資額（円）", type: "number", min: 1 },
      { id: "profit", label: "年間収益（円）", type: "number", min: 0 }
    ],
    calc: v => {
      const rate = v.profit / v.amount * 100;
      return {
        result: `利回り ${rate.toFixed(2)} %`,
        note: "単純利回りです。税金・維持費・売却損益等は含みません。"
      };
    }
  },

  retirement: {
    title: "老後資金計算",
    description: "老後の毎月不足額から、必要となる生活資金を概算します。",
    fields: [
      { id: "shortfall", label: "毎月の不足額（円）", type: "number", min: 0 },
      { id: "years", label: "老後期間（年）", type: "number", min: 0, step: 1 }
    ],
    calc: v => {
      const total = v.shortfall * v.years * 12;
      return {
        result: `必要資金 ${yen(total)}`,
        note: "運用益・インフレ・公的年金の変動等を考慮しない概算です。"
      };
    }
  },

  education: {
    title: "教育費計算",
    description: "年間教育費と教育期間から必要な教育費総額を計算します。",
    fields: [
      { id: "annual", label: "年間教育費（円）", type: "number", min: 0 },
      { id: "years", label: "教育期間（年）", type: "number", min: 0, step: 1 }
    ],
    calc: v => {
      const total = v.annual * v.years;
      return {
        result: `教育費総額 ${yen(total)}`,
        note: "毎年同じ金額がかかる前提の概算です。"
      };
    }
  },

  budget: {
    title: "家計収支計算",
    description: "毎月の収入と支出から収支を計算します。",
    fields: [
      { id: "income", label: "月収（手取り・円）", type: "number", min: 0 },
      { id: "expense", label: "毎月の支出（円）", type: "number", min: 0 }
    ],
    calc: v => {
      const balance = v.income - v.expense;
      return {
        result: `月間収支 ${yen(balance)}`,
        note: balance >= 0 ? "黒字です。" : "赤字です。"
      };
    }
  },

  houseLoan: {
    title: "住宅ローン返済計算",
    description: "住宅ローンの毎月返済額を計算します。",
    fields: [
      { id: "principal", label: "借入額（円）", type: "number", min: 0 },
      { id: "rate", label: "年利（%）", type: "number", min: 0, step: 0.01 },
      { id: "years", label: "返済期間（年）", type: "number", min: 1, step: 1 }
    ],
    calc: v => loanResult(v.principal, v.rate, v.years)
  },

  purchase: {
    title: "住宅購入予算計算",
    description: "自己資金・借入可能額・諸費用率から購入予算を概算します。",
    fields: [
      { id: "own", label: "自己資金（円）", type: "number", min: 0 },
      { id: "borrow", label: "借入可能額（円）", type: "number", min: 0 },
      { id: "costRate", label: "購入諸費用率（%）", type: "number", min: 0, step: 0.1, value: 8 }
    ],
    calc: v => {
      const budget = (v.own + v.borrow) / (1 + v.costRate / 100);
      return {
        result: `購入価格の目安 ${yen(budget)}`,
        note: "自己資金＋借入額を、諸費用込みの総予算として単純計算しています。"
      };
    }
  },

  burden: {
    title: "家賃・住宅ローン負担率",
    description: "住宅費が月収に占める割合を計算します。",
    fields: [
      { id: "housing", label: "家賃・住宅ローン（月額・円）", type: "number", min: 0 },
      { id: "income", label: "月収（手取り・円）", type: "number", min: 1 }
    ],
    calc: v => {
      const rate = v.housing / v.income * 100;
      return {
        result: `住宅費負担率 ${rate.toFixed(2)} %`,
        note: "手取り月収に対する住宅費の割合です。"
      };
    }
  },

  broker: {
    title: "仲介手数料計算",
    description: "売買価格から宅建業法上の上限額を参考に簡易計算します。",
    fields: [
      { id: "price", label: "売買価格（円）", type: "number", min: 0 }
    ],
    calc: v => {
      const p = v.price;
      let feeBeforeTax;

      if (p <= 2000000) {
        feeBeforeTax = p * 0.05;
      } else if (p <= 4000000) {
        feeBeforeTax = 2000000 * 0.05 + (p - 2000000) * 0.04;
      } else {
        feeBeforeTax =
          2000000 * 0.05 +
          2000000 * 0.04 +
          (p - 4000000) * 0.03;
      }

      const fee = feeBeforeTax * 1.10;

      return {
        result: `仲介手数料上限の目安 ${yen(fee)}`,
        note: "通常の料率による簡易計算です。低廉な空家等の特例など、個別の特例は別途確認してください。"
      };
    }
  },

  propertyYield: {
    title: "不動産投資利回り",
    description: "購入価格と年間家賃から表面利回りを計算します。",
    fields: [
      { id: "price", label: "購入価格（円）", type: "number", min: 1 },
      { id: "rent", label: "年間家賃収入（円）", type: "number", min: 0 }
    ],
    calc: v => {
      const rate = v.rent / v.price * 100;
      return {
        result: `表面利回り ${rate.toFixed(2)} %`,
        note: "年間家賃収入÷購入価格で計算する表面利回りです。経費・空室・税金等は考慮していません。"
      };
    }
  },

  rentBuy: {
    title: "賃貸 vs 購入",
    description: "指定期間の家賃総額と住宅ローン返済総額を単純比較します。",
    fields: [
      { id: "rent", label: "月額家賃（円）", type: "number", min: 0 },
      { id: "loan", label: "住宅ローン月額（円）", type: "number", min: 0 },
      { id: "years", label: "比較期間（年）", type: "number", min: 1, step: 1 }
    ],
    calc: v => {
      const rentTotal = v.rent * v.years * 12;
      const loanTotal = v.loan * v.years * 12;
      const diff = rentTotal - loanTotal;

      return {
        result:
          `家賃 ${yen(rentTotal)} ／ ローン ${yen(loanTotal)} ／ 差額 ${yen(Math.abs(diff))}`,
        note:
          diff > 0
            ? "単純比較では、家賃総額のほうが大きくなります。"
            : diff < 0
              ? "単純比較では、住宅ローン返済額のほうが大きくなります。"
              : "指定期間では同額です。"
      };
    }
  }
};


let currentCalculator = null;


function yen(value) {
  return Math.round(value).toLocaleString("ja-JP") + " 円";
}


function loanResult(principal, annualRate, years) {
  const months = Math.round(years * 12);
  const monthlyRate = annualRate / 100 / 12;

  let payment;

  if (monthlyRate === 0) {
    payment = principal / months;
  } else {
    payment =
      principal *
      monthlyRate *
      Math.pow(1 + monthlyRate, months) /
      (Math.pow(1 + monthlyRate, months) - 1);
  }

  const total = payment * months;

  return {
    result: `毎月返済額 ${yen(payment)}`,
    note: `総返済額の目安 ${yen(total)}。元利均等返済・ボーナス返済なしで計算しています。`
  };
}


function openCalc(type) {
  const calc = calculators[type];
  if (!calc) return;

  currentCalculator = type;

  document.getElementById("hpsCalcTitle").textContent = calc.title;
  document.getElementById("hpsCalcDescription").textContent = calc.description;

  const fields = document.getElementById("hpsCalcFields");
  fields.innerHTML = "";

  calc.fields.forEach(field => {
    const wrapper = document.createElement("div");
    wrapper.className = "hps-calc-field";

    const label = document.createElement("label");
    label.htmlFor = "hps-field-" + field.id;
    label.textContent = field.label;

    const input = document.createElement("input");
    input.id = "hps-field-" + field.id;
    input.name = field.id;
    input.type = field.type;

    if (field.min !== undefined) input.min = field.min;
    if (field.max !== undefined) input.max = field.max;
    if (field.step !== undefined) input.step = field.step;
    if (field.value !== undefined) input.value = field.value;

    if (field.type === "number") {
      input.inputMode = "decimal";
    }

    wrapper.appendChild(label);
    wrapper.appendChild(input);
    fields.appendChild(wrapper);
  });

  document.getElementById("hpsCalcResult").classList.remove("is-visible");
  document.getElementById("hpsCalcResultMain").textContent = "";
  document.getElementById("hpsCalcNote").textContent = "";

  document.getElementById("hpsCalcOverlay").classList.add("is-open");
  document.body.style.overflow = "hidden";

  const first = fields.querySelector("input");
  if (first) {
    setTimeout(() => first.focus(), 50);
  }
}


function calculate(event) {
  event.preventDefault();

  if (!currentCalculator) return;

  const calc = calculators[currentCalculator];
  const values = {};

  for (const field of calc.fields) {
    const input = document.getElementById("hps-field-" + field.id);

    if (field.type === "number") {
      values[field.id] = Number(input.value);
    } else {
      values[field.id] = input.value;
    }
  }

  const result = calc.calc(values);

  document.getElementById("hpsCalcResultMain").textContent = result.result;
  document.getElementById("hpsCalcNote").textContent = result.note;
  document.getElementById("hpsCalcResult").classList.add("is-visible");
}


function closeCalc() {
  document.getElementById("hpsCalcOverlay").classList.remove("is-open");
  document.body.style.overflow = "";
  currentCalculator = null;
}


function overlayClose(event) {
  if (event.target === document.getElementById("hpsCalcOverlay")) {
    closeCalc();
  }
}


function activateCalc(event, type) {
  if (event.key === "Enter" || event.key === " ") {
    event.preventDefault();
    openCalc(type);
  }
}


document.addEventListener("keydown", function(event) {
  if (event.key === "Escape") {
    closeCalc();
  }
});
</script>

