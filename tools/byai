<style>
/* =========================================================
   HakuRo Project Studio - Calculation Tools
   既存CSSとの衝突を避けるため、専用クラス名を使用
   ========================================================= */

.hps-calc-page {
  width: 100%;
}

.hps-calc-category {
  margin-bottom: 32px;
}

.hps-calc-category-title {
  margin-bottom: 8px;
}

.hps-calc-category-description {
  margin-top: 0;
  margin-bottom: 20px;
}

.hps-calc-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

/* buttonではなくdivを使い、既存button CSSの影響を回避 */
.hps-calc-tool-item {
  display: block !important;
  width: 100% !important;
  min-height: 118px;
  box-sizing: border-box;
  padding: 20px !important;
  border: 1px solid #d8ded8 !important;
  border-radius: 12px !important;
  background: #ffffff !important;
  color: #333333 !important;
  opacity: 1 !important;
  text-align: left;
  cursor: pointer !important;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}

.hps-calc-tool-item:hover {
  transform: translateY(-2px);
  border-color: #9aaa9a !important;
  box-shadow: 0 5px 14px rgba(0,0,0,0.09);
}

.hps-calc-tool-item:focus {
  outline: 2px solid #7d987d;
  outline-offset: 2px;
}

.hps-calc-tool-item h3,
.hps-calc-tool-item p,
.hps-calc-tool-item span {
  color: #333333 !important;
  opacity: 1 !important;
}

.hps-calc-tool-item h3 {
  margin: 0 0 8px;
  font-size: 1.05rem;
}

.hps-calc-tool-item p {
  margin: 0;
  font-size: 0.9rem;
  line-height: 1.6;
}

.hps-calc-tool-label {
  display: inline-block;
  margin-bottom: 9px;
  padding: 3px 8px;
  border-radius: 999px;
  background: #eef3ee !important;
  color: #617261 !important;
  font-size: 0.72rem;
}

/* ---------- モーダル ---------- */

.hps-calc-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
  box-sizing: border-box;
  background: rgba(0,0,0,0.48) !important;
}

.hps-calc-overlay.is-open {
  display: flex;
}

.hps-calc-modal {
  position: relative;
  width: min(620px, 100%);
  max-height: 90vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 28px;
  border-radius: 16px;
  background: #ffffff !important;
  color: #333333 !important;
  box-shadow: 0 12px 40px rgba(0,0,0,0.25);
}

.hps-calc-modal h2,
.hps-calc-modal p,
.hps-calc-modal label {
  color: #333333 !important;
}

.hps-calc-close {
  position: absolute;
  top: 10px;
  right: 14px;
  border: 0 !important;
  background: transparent !important;
  color: #666666 !important;
  font-size: 28px;
  line-height: 1;
  cursor: pointer;
  opacity: 1 !important;
  padding: 4px 8px !important;
}

.hps-calc-close:hover {
  color: #222222 !important;
}

.hps-calc-modal-title {
  margin: 0 40px 6px 0;
}

.hps-calc-modal-description {
  margin-top: 0;
  margin-bottom: 22px;
  color: #666666 !important;
}

.hps-calc-form {
  display: grid;
  gap: 15px;
}

.hps-calc-field {
  display: grid;
  gap: 6px;
}

.hps-calc-field label {
  font-weight: 600;
  font-size: 0.9rem;
}

.hps-calc-field input,
.hps-calc-field select {
  width: 100%;
  box-sizing: border-box;
  padding: 10px 12px;
  border: 1px solid #cfd6cf !important;
  border-radius: 8px;
  background: #ffffff !important;
  color: #333333 !important;
  font-size: 16px;
  opacity: 1 !important;
}

.hps-calc-field input:focus,
.hps-calc-field select:focus {
  outline: 2px solid #9aae9a;
  outline-offset: 1px;
}

.hps-calc-submit {
  width: 100%;
  margin-top: 6px;
  padding: 12px 16px !important;
  border: 0 !important;
  border-radius: 9px !important;
  background: #667d67 !important;
  color: #ffffff !important;
  opacity: 1 !important;
  cursor: pointer !important;
  font-size: 1rem;
  font-weight: 600;
}

.hps-calc-submit:hover {
  background: #566b57 !important;
}

.hps-calc-result {
  display: none;
  margin-top: 20px;
  padding: 18px;
  border-radius: 10px;
  background: #f1f5f1 !important;
  color: #333333 !important;
}

.hps-calc-result.is-visible {
  display: block;
}

.hps-calc-result-main {
  margin: 0;
  font-size: 1.3rem;
  font-weight: 700;
}

.hps-calc-note {
  margin: 12px 0 0;
  font-size: 0.82rem;
  line-height: 1.6;
  color: #666666 !important;
}

.hps-calc-footer-note {
  margin-top: 28px;
  font-size: 0.82rem;
  color: #777777;
  line-height: 1.7;
}

@media (max-width: 800px) {
  .hps-calc-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 520px) {
  .hps-calc-grid {
    grid-template-columns: 1fr;
  }

  .hps-calc-modal {
    padding: 22px 18px;
  }
}
</style>

